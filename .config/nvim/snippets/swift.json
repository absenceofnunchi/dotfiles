{
  "public access control": {
    "prefix": "pub",
    "body": ["public $0"]
  },
  "private access control": {
    "prefix": "priv",
    "body": ["private $0"]
  },
  "if statement": {
    "prefix": "if",
    "body": [
      "if $1 {",
      "  $2",
      "}$0"
    ]
  },
  "if let": {
    "prefix": "ifl",
    "body": [
      "if let $1 = ${2:$1} {",
      "  $3",
      "}$0"
    ]
  },
  "if case let": {
    "prefix": "ifcl",
    "body": [
      "if case let $1 = ${2:$1} {",
      "  $3",
      "}$0"
    ]
  },
  "function declaration": {
    "prefix": "func",
    "body": [
      "func $1($2) $3{",
      "  $0",
      "}"
    ]
  },
  "async function declaration": {
    "prefix": "funca",
    "body": [
      "func $1($2) async $3{",
      "  $0",
      "}"
    ]
  },
  "guard": {
    "prefix": "guard",
    "body": [
      "guard $1 else {",
      "  $2",
      "}$0"
    ]
  },
  "guard let": {
    "prefix": "guardl",
    "body": [
      "guard let $1 else {",
      "  $2",
      "}$0"
    ]
  },
  "main": {
    "prefix": "main",
    "body": [
      "@main public struct ${1:App} {",
      "  public static func main() {",
      "    $2",
      "  }",
      "}$0"
    ]
  }
}
